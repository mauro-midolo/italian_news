{
  "name": "italian_news",
  "compatibility_date": "2026-09-02",
  // Il Worker gestisce solo l'API dell'editor (/modifica/api/...): tutto il
  // resto sono gli asset statici di public/, serviti senza passare dal codice.
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/modifica/api/*"]
  },
  // Al massimo 5 tentativi di password al minuto per indirizzo IP.
  "ratelimits": [
    {
      "name": "LIMITE_ACCESSI",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Configurazione non segreta dell'editor. I segreti (GITHUB_TOKEN,
  // EDITOR_PASSWORD) si impostano nella dashboard di Cloudflare come
  // "Secret": vedi worker/index.js.
  "vars": {
    "GITHUB_REPO": "mauro-midolo/italian_news",
    "GITHUB_BRANCH": "main",
    "DETAILS_PATH": "details.info"
  }
}
