{#-
  Fascia "Casa" de Il Quotidiano: legge da Home Assistant le temperature
  delle stanze che scripts/casa.py trasforma in HTML.

  La routine quotidiana passa questo file, cosi' com'e', al tool
  ha_eval_template del connettore Home Assistant e salva la risposta
  (una riga di JSON) in .cache/casa.json, senza ritoccarla. Qui si leggono
  solo gli stati: la formattazione sta in casa.py, cosi' nessun numero passa
  dall'AI.

  Temperature dei sensori Tado. Quelle interne dei Daikin non si usano:
  leggono 3-5 gradi in piu'.
-#}
{%- set stanze = [
  ('sala', 'Sala'),
  ('cucina', 'Cucina'),
  ('ingresso', 'Ingresso'),
  ('camera_matrimoniale', 'Camera matrimoniale'),
  ('cameretta', 'Cameretta'),
  ('stanza_delle_bimbe', 'Stanza delle bimbe'),
  ('bagno', 'Bagno'),
  ('bagnetto', 'Bagnetto'),
  ('tavernetta', 'Tavernetta'),
  ('garage', 'Garage'),
] -%}
{%- set ns = namespace(stanze=[]) -%}
{%- for id, nome in stanze -%}
  {%- set ns.stanze = ns.stanze + [{
    'nome': nome,
    'temperatura': states('sensor.' ~ id ~ '_temperature'),
  }] -%}
{%- endfor -%}
{{ {
  'versione': 2,
  'letto_alle': now().isoformat(),
  'stanze': ns.stanze,
} | tojson }}
